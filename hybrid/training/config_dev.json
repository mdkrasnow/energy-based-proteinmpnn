{
    "experiment_name": "energy_model_dev_training",
    "seed": 42,
    
    "data": {
        "data_dir": "proteinmpnn/inputs/PDB_monomers/pdbs",
        "positive_ratio": 0.5,
        "negative_methods": ["random"],
        "max_sequence_length": 200,
        "min_sequence_length": 20,
        "val_split": 0.3,
        "lazy_loading": true,
        "max_files_debug": 4,
        "structure_extensions": [".pdb"],
        "include_subdirectories": false
    },
    
    "model": {
        "mpnn_encoder": {
            "model_name": "v_48_020",
            "hidden_dim": 128,
            "freeze_layers": true
        },
        "energy_head": {
            "hidden_dim": 256,
            "num_layers": 2,
            "dropout": 0.1,
            "activation": "relu",
            "use_batch_norm": true
        },
        "sequence_repr": {
            "temperature_schedule": [1.0, 0.5],
            "min_temperature": 0.01,
            "max_temperature": 2.0
        }
    },
    
    "loss": {
        "margin": 1.0,
        "temperature": 0.1,
        "ranking_weight": 1.0,
        "contrastive_weight": 1.0,
        "entropy_weight": 0.01,
        "smoothness_weight": 0.001,
        "negative_weights": {
            "random": 1.0
        }
    },
    
    "optimization": {
        "optimizer": "adamw",
        "learning_rate": 1e-3,
        "weight_decay": 0.01,
        "betas": [0.9, 0.999],
        "eps": 1e-8,
        "scheduler": {
            "type": "reduce_on_plateau",
            "factor": 0.5,
            "patience": 3
        }
    },
    
    "training": {
        "max_epochs": 3,
        "batch_size": 4,
        "num_workers": 2,
        "max_grad_norm": 1.0,
        "patience": 5,
        "save_frequency": 1
    },
    
    "resume_from_checkpoint": null
}